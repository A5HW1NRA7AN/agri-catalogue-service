{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "livestockBreedId": {
      "type": "string",
      "prefix": "breed-",
      "key": "Primary",
      "keyLength": 12,
      "readOnly": true,
      "description": "Auto-generated primary key for the livestock breed."
    },
    "livestockBreedName": {
      "type": "string",
      "description": "Breed name. Mandatory."
    },
    "livestockCategoryId": {
      "type": "string",
      "description": "Reference to the primary key of the Livestock Category catalogue."
    },
    "livestockCategoryName": {
      "type": "string",
      "description": "Livestock category name. Mandatory."
    }
  },
  "required": [
    "livestockBreedName",
    "livestockCategoryName",
    "livestockCategoryId"
  ]
}
