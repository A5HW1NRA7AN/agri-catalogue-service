{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "locationObjectId": {
            "type": "string",
            "prefix": "locationobject-",
            "key": "Primary",
            "keyLength": 12,
            "description": "description about locationObjectId"
        },
        "locationName": {
            "type": "string",
            "description": "name of the location"
        },
        "locationOrder": {
            "type": "integer",
            "description": "ordering/rank of the location within its level"
        },
        "locationRefN": {
            "type": "string",
            "description": "reference name of the location"
        },
        "locationAltN": {
            "type": "string",
            "description": "alternate name of the location"
        },
        "locationAl_1": {
            "type": "string",
            "description": "additional alternate name of the location"
        },
        "locationLat": {
            "type": "number",
            "description": "latitude of the location"
        },
        "locationLong": {
            "type": "number",
            "description": "longitude of the location"
        },
        "locationShapeLeng": {
            "type": "number",
            "description": "shape (perimeter) length of the location geometry"
        },
        "locationShapeArea": {
            "type": "number",
            "description": "shape area of the location geometry"
        },
        "locationGeom": {
            "type": "string",
            "description": "geometry of the location"
        }
    },
    "required": [
        "locationName",
        "locationOrder"
    ]
}